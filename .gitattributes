# Ship only what the action needs at runtime (action.yaml, LICENSE and the files of scripts/).
# Everything else is excluded from `git archive`, which is what the consumers of a release get.
# When the action starts using a new file, un-ignore it here and add it to EXPECTED in
# tests/check_export.sh.
/.github/ export-ignore
/.idea/ export-ignore
/.make/ export-ignore
/review/ export-ignore
/src/ export-ignore
/tests/ export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.markdownlint.json export-ignore
/.yamllint.yaml export-ignore
/CLAUDE.md export-ignore
/CODEOWNERS export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md export-ignore
/Makefile export-ignore
/README.md export-ignore
/SECURITY.md export-ignore
/pyproject.toml export-ignore
